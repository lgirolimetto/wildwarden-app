 "lore": {
  "Eranthis hyemalis": {
   "it": "Il Piè di gallo fiorisce quando il bosco dorme ancora: il suo oro trattiene la prima luce dell'anno. Gli erboristi lo chiamano 'la lanterna di gennaio'."
  },
  "Helleborus viridis": {
   "it": "L'Elleboro verde non teme la neve. La sua essenza è fredda e paziente, e conserva le cose invece di trasformarle."
  },
  "Fagus sylvatica": {
   "it": "Sotto i faggi il silenzio ha un peso. L'essenza di faggio si raccoglie solo in quota, dove le voci della pianura non arrivano."
  },
  "Malva sylvestris": {
   "it": "La Malva non chiede nulla: cresce nei fossi, nei cortili, lungo i binari. La sua essenza è comune, ma nessuna ricetta di base ne fa a meno."
  }
 },
 "funFacts": {
  "Eranthis hyemalis": [
   {
    "level": 1,
    "text": {
     "it": "Eranthis viene dal greco 'er' (primavera) e 'anthos' (fiore), mentre hyemalis significa 'invernale': un fiore di primavera che sboccia in pieno inverno."
    },
    "verified": false
   }
  ],
  "Malva sylvestris": [
   {
    "level": 1,
    "text": {
     "it": "Un vecchio proverbio dice 'la malva, da ogni mal ti salva': per secoli è stata tra le piante più presenti nella tradizione popolare."
    },
    "verified": false
   }
  ],
  "Fagus sylvatica": [
   {
    "level": 2,
    "text": {
     "it": "Secondo un'etimologia diffusa (ma discussa), il tedesco Buch, 'libro', viene da Buche, 'faggio': le prime rune si incidevano su tavolette di faggio."
    },
    "verified": false
   }
  ]
 },
